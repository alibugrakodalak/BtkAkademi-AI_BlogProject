
@{
    ViewData["Title"] = "ArticleDetail";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="back-wrapper">

    @await Component.InvokeAsync("_ArticleDetailBreadCrumbsComponentPartial", new {id = ViewBag.i})
    
    <div class="back__blog__area back-blog-page back-blog-page-single pt-70 pb-60">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    <div class="blog-single-inner">
                        <div class="blog-content">
                            
                            @await Component.InvokeAsync("_ArticleDetailMainContentComponentPartial", new { id = ViewBag.i })

                            @await Component.InvokeAsync("_ArticleDetailArticleTagsByArticleComponentPartial")
                            
                            @await Component.InvokeAsync("_ArticleDetailAuthorByArticleComponentPartial", new { id = ViewBag.i })
                            
                            @await Component.InvokeAsync("_ArticleDetailPreviousAndNextPostComponentPartial", new { id = ViewBag.i })

                            @await Component.InvokeAsync("_ArticleDetailRelatedPostsComponentPartial", new { id = ViewBag.i })

                            @await Component.InvokeAsync("_ArticleDetailCommentListByArticleComponentPartial", new { id = ViewBag.i })

                            @await Component.InvokeAsync("_ArticleDetailAddCommentByArticleComponentPartial", new { id = ViewBag.i })

                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="back-sidebar pl-30 md-pl-0 back-hero-area back-latest-posts back-whats-posts">

                        @await Component.InvokeAsync("_ArticleDetailSearchAreaComponentPartial")

                        @await Component.InvokeAsync("_ArticleDetailSocialMediaComponentPartial")

                        @await Component.InvokeAsync("_ArticleDetailFollowUsComponentPartial")

                        @await Component.InvokeAsync("_ArticleDetailLatestNewComponentPartial")
                        
                        @await Component.InvokeAsync("_ArticleDetailLastCommentsComponentPartial")

                        @await Component.InvokeAsync("_ArticleDetailTagCloudsComponentPartial")
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

