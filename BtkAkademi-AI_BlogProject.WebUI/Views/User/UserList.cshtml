@model List<ResultUserDto>

@{
    ViewData["Title"] = "Kullanıcı Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<style>
    .user-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .card-header-custom {
        background: #fff;
        border-bottom: 1px solid #edf2f7;
        padding: 25px;
    }

    .page-title {
        font-weight: 700;
        color: #344767;
    }

    .stat-badge {
        background: #eef4ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .search-box input {
            height: 48px;
            border-radius: 12px;
            padding-left: 45px;
            border: 1px solid #dee2e6;
        }

            .search-box input:focus {
                box-shadow: none;
                border-color: #0d6efd;
            }

    .modern-table thead {
        background: #f8fafc;
    }

        .modern-table thead th {
            border: none;
            font-weight: 600;
            color: #344767;
            padding: 18px;
            white-space: nowrap;
        }

    .modern-table tbody td {
        padding: 18px;
        border-color: #edf2f7;
        vertical-align: middle;
    }

    .modern-table tbody tr {
        transition: all .25s ease;
    }

        .modern-table tbody tr:hover {
            background: #f8fafc;
        }

    .user-id {
        background: #f1f5f9;
        color: #475569;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .user-avatar {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 50%;
        border: 3px solid #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,.1);
    }

    .user-name {
        font-weight: 600;
        color: #344767;
    }

    .user-status {
        font-size: 12px;
        color: #22c55e;
        font-weight: 500;
    }

    .username-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eef4ff;
        color: #0d6efd;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .email-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        color: #475569;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .25s;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-view {
        background: rgba(13,110,253,.12);
        color: #0d6efd;
    }

    .btn-edit {
        background: rgba(255,193,7,.18);
        color: #ff9800;
    }

    .btn-delete {
        background: rgba(220,53,69,.12);
        color: #dc3545;
    }
</style>

<main class="page-content">

    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
        <div class="breadcrumb-title pe-3 fw-bold">
            Kullanıcılar
        </div>

        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#">
                            <i class="bx bx-home-alt"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Kullanıcı Listesi
                    </li>
                </ol>
            </nav>
        </div>

        <div class="ms-auto">
            <a href="/User/CreateUser/" class="btn btn-primary px-4">
                <i class="bi bi-person-plus-fill me-2"></i>
                Yeni Kullanıcı
            </a>
        </div>
    </div>

    <div class="card user-card">

        <div class="card-header-custom">
            <div class="row align-items-center">

                <div class="col-lg-6">
                    <h4 class="page-title">
                        <i class="bi bi-people-fill text-primary"></i>
                        Kullanıcı Yönetimi
                    </h4>
                </div>

                <div class="col-lg-4 ms-auto mt-3 mt-lg-0">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Kullanıcı ara..." />
                    </div>
                </div>

            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table modern-table mb-0" id="userTable">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kullanıcı</th>
                            <th>Kullanıcı Adı</th>
                            <th>Ünvan</th>
                            <th>E-Posta</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>

                                <td>
                                    <span class="user-id">
                                        @count
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">

                                        <img src="@item.ImageUrl"
                                             onerror="this.src='https://ui-avatars.com/api/?name=User'"
                                             class="user-avatar">

                                        <div>

                                            <div class="user-name">
                                                @item.Name @item.Surname
                                            </div>

                                            <div class="user-status">
                                                <i class="bi bi-circle-fill"
                                                   style="font-size:7px"></i>
                                                Aktif Kullanıcı
                                            </div>

                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="username-badge">
                                        @item.Username
                                    </span>
                                </td>

                                <td>
                                    <span class="username-badge">
                                        @item.Title
                                    </span>
                                </td>

                                <td>
                                    <span class="email-badge">
                                        <i class="bi bi-envelope-fill"></i>
                                        @item.Email
                                    </span>
                                </td>

                                <td>

                                    <div class="d-flex justify-content-center gap-2">

                                        <a href="/User/UserDetail/@item.Id"
                                               class="action-btn btn-view"
                                               data-bs-toggle="tooltip"
                                               title="Detaylar">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <a href="/User/UpdateUser/@item.Id"
                                               class="action-btn btn-edit"
                                               data-bs-toggle="tooltip"
                                               title="Güncelle">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a href="/User/DeleteUser/@item.Id"
                                               class="action-btn btn-delete"
                                               data-bs-toggle="tooltip"
                                               title="Sil">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</main>

<script>
    document.getElementById("searchInput")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();
            let rows = document.querySelectorAll("#userTable tbody tr");

            rows.forEach(function (row) {

                let text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(value) ? "" : "none";
            });
        });
</script>