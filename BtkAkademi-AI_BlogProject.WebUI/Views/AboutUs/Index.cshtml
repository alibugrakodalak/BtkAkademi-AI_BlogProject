@model ResultAboutDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
    var yearsActive = Model != null ? DateTime.Now.Year - Model.StartWorkingYear : 0;
}

<section class="about-page">
    <style>
        .about-page {
            --navy: #0F1B33;
            --navy-soft: #16213E;
            --blue: #2E8CFF;
            --ink: #16213A;
            --muted: #6B7280;
            --paper: #FFFFFF;
            --surface: #F7F9FC;
            --line: #E7ECF3;
            background: var(--surface);
        }

        .about-page * { box-sizing: border-box; }
        .about-page a { text-decoration: none; }
        .about-page a:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }

        /* ---------- Hero band ---------- */
        .about-hero {
            background: linear-gradient(165deg, var(--navy) 0%, var(--navy-soft) 100%);
            padding: 3.75rem 1.5rem 6rem;
            text-align: center;
            color: #fff;
        }
        .about-hero-inner { max-width: 40rem; margin: 0 auto; }
        .about-hero .eyebrow {
            display: inline-block;
            font-size: .75rem;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            color: var(--blue);
            margin-bottom: .9rem;
        }
        .about-hero h1 {
            font-size: clamp(1.9rem, 3.2vw, 2.6rem);
            font-weight: 700;
        }

        /* ---------- Body ---------- */
        .about-body-wrap { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem 4rem; }

        .about-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.5rem;
            transform: translateY(-3.25rem);
            margin-bottom: -1.25rem;
        }
        .stat-card {
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: 18px;
            padding: 1.75rem 1rem;
            text-align: center;
            box-shadow: 0 16px 32px -22px rgba(15, 27, 51, .28);
        }
        .stat-number { display: block; font-size: 2rem; font-weight: 800; color: var(--blue); margin-bottom: .35rem; }
        .stat-label { font-size: .78rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }

        .about-main {
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            gap: 3rem;
            align-items: start;
            margin-top: 2.5rem;
        }
        .about-main.about-main--full { grid-template-columns: 1fr; }

        .about-image-wrap {
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px -24px rgba(15, 27, 51, .3);
            position: sticky;
            top: 2rem;
        }
        .about-image { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; }

        .about-content { color: var(--ink); font-size: 1rem; line-height: 1.8; }
        .about-content p { margin-bottom: 1.1rem; }
        .about-content h2, .about-content h3 { font-weight: 700; color: var(--ink); margin: 1.6rem 0 .8rem; }
        .about-content ul, .about-content ol { margin: 0 0 1.1rem 1.3rem; }
        .about-content li { margin-bottom: .4rem; }
        .about-content a { color: var(--blue); text-decoration: underline; }
        .about-content strong { color: var(--ink); }

        .about-cta {
            margin-top: 3rem;
            background: var(--paper);
            border: 1px solid var(--line);
            border-radius: 20px;
            padding: 2rem 2.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            flex-wrap: wrap;
            box-shadow: 0 16px 32px -24px rgba(15, 27, 51, .2);
        }
        .about-cta h3 { color: var(--ink); font-size: 1.15rem; margin-bottom: .3rem; }
        .about-cta p { color: var(--muted); font-size: .9rem; }
        .about-cta-btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            background: var(--blue);
            color: #fff;
            font-weight: 700;
            font-size: .9rem;
            padding: .75rem 1.4rem;
            border-radius: 999px;
            white-space: nowrap;
            transition: background .15s ease;
        }
        .about-cta-btn:hover { background: #1D6FE0; }
        .about-cta-btn i { transition: transform .15s ease; }
        .about-cta-btn:hover i { transform: translateX(3px); }

        /* ---------- Empty state ---------- */
        .about-empty-wrap { max-width: 1100px; margin: 0 auto; padding: 4rem 1.5rem; }
        .about-empty { text-align: center; padding: 3.5rem 1.5rem; border: 1px dashed var(--line); border-radius: 18px; background: var(--paper); }
        .about-empty h3 { color: var(--ink); font-size: 1.1rem; margin-bottom: .5rem; }
        .about-empty p { color: var(--muted); font-size: .9rem; }

        @@media (max-width: 820px) {
            .about-stats { grid-template-columns: 1fr; transform: translateY(-2.25rem); }
            .about-main { grid-template-columns: 1fr; gap: 2rem; }
            .about-image-wrap { position: static; }
            .about-image { aspect-ratio: 16 / 9; }
        }
    </style>

    @if (Model == null)
    {
        <div class="about-empty-wrap">
            <div class="about-empty">
                <h3>İçerik bulunamadı</h3>
                <p>Hakkımızda içeriği henüz eklenmemiş.</p>
            </div>
        </div>
    }
    else
    {
        <div class="about-hero">
            <div class="about-hero-inner">
                <span class="eyebrow">Hikayemiz</span>
                <h1 style="color: white !important">@Model.Title</h1>
            </div>
        </div>

        <div class="about-body-wrap">
            <div class="about-stats">
                <div class="stat-card">
                    <span class="stat-number">@Model.StartWorkingYear</span>
                    <span class="stat-label">Kuruluş Yılı</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@yearsActive+</span>
                    <span class="stat-label">Yıllık Deneyim</span>
                </div>
                <div class="stat-card">
                    <span class="stat-number">@Model.EmployeeCount+</span>
                    <span class="stat-label">Ekip Üyesi</span>
                </div>
            </div>

            <div class="about-main @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "about-main--full" : "")">
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="about-image-wrap">
                        <img class="about-image" src="@Model.ImageUrl" alt="@Model.Title" loading="lazy" />
                    </div>
                }
                <div class="about-content">
                    @Html.Raw(Model.Content)
                </div>
            </div>

            <div class="about-cta">
                <div>
                    <h3>Sorularınız mı var?</h3>
                    <p>Ekibimizle iletişime geçmekten çekinmeyin.</p>
                </div>
                <a class="about-cta-btn" href="/Contact/SendMessage/">
                    Bize Yazın
                    <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    }
</section>


