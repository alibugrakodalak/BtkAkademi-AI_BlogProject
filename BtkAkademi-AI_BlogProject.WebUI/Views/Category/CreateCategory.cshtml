@model CreateCategoryDto

@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .form-card {
        max-width: 700px;
        margin: auto;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .form-header {
        padding: 25px;
        background: linear-gradient(135deg,#0d6efd,#3d8bfd);
        color: white;
    }

    .form-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .form-subtitle {
        opacity: .8;
    }

    .modern-input {
        height: 55px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
    }

        .modern-input:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }

    .save-btn {
        height: 50px;
        border-radius: 12px;
        font-weight: 600;
    }
</style>

<main class="page-content">

    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
        <div class="breadcrumb-title pe-3">
            Kategoriler
        </div>

        <div class="ps-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <i class="bx bx-home-alt"></i>
                </li>
                <li class="breadcrumb-item active">
                    Yeni Kategori
                </li>
            </ol>
        </div>
    </div>

    <div class="card form-card">

        <div class="form-header">
            <div class="form-title">
                <i class="bi bi-folder-plus me-2"></i>
                Yeni Kategori Oluştur
            </div>

            <div class="form-subtitle">
                Blog içeriklerini gruplamak için yeni bir kategori ekleyin.
            </div>
        </div>

        <div class="card-body p-4">

            <form method="post">

                <div class="mb-4">

                    <label class="form-label fw-semibold">
                        Kategori Adı
                    </label>

                    <input type="text"
                           asp-for="CategoryName"
                           class="form-control modern-input"
                           placeholder="Örn: Teknik Analiz" />

                </div>

                <button class="btn btn-primary save-btn w-100">
                    <i class="bi bi-check-circle me-2"></i>
                    Kategoriyi Oluştur
                </button>

            </form>

        </div>

    </div>

</main>