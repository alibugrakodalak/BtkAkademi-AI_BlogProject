@model UserLoginDto
@{
    Layout = null;
}

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="assets/images/favicon-32x32.png" type="image/png" />

    <link href="https://fonts.googleapis.com/css?family=Fraunces:400,500,600|Inter:400,500,600,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">

    <title>Folio — Giriş yap</title>

    <style>
        :root {
            --ink: #0F172A;
            --muted: #5B6B84;
            --primary: #1D4ED8;
            --primary-dark: #1E3A8A;
            --primary-light: #3B82F6;
            --paper: #FFFFFF;
            --line: #E3EBF7;
            --field-bg: #F8FAFF;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            color: var(--ink);
            background: var(--paper);
            -webkit-font-smoothing: antialiased;
        }
        a { color: inherit; text-decoration: none; }
        button { font-family: inherit; cursor: pointer; }
        a:focus-visible, button:focus-visible {
            outline: 2px solid var(--primary-light);
            outline-offset: 2px;
        }

        .auth-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.15fr 1fr;
        }

        /* ---------- Left showcase panel ---------- */
        .showcase {
            position: relative;
            overflow: hidden;
            background: linear-gradient(165deg, #EAF2FF 0%, #DCE9FE 48%, #CDE1FF 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: clamp(2.5rem, 5vw, 5rem);
        }

        .showcase-quote {
            position: absolute;
            top: -0.12em;
            left: -0.05em;
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: clamp(260px, 26vw, 380px);
            line-height: 1;
            color: rgba(29, 78, 216, 0.07);
            user-select: none;
            pointer-events: none;
        }

        .showcase-content { position: relative; z-index: 1; max-width: 30rem; margin-bottom: 3rem; }
        .eyebrow {
            display: inline-block;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .16em;
            text-transform: uppercase;
            color: var(--primary);
            margin-bottom: 1rem;
        }
        .showcase-content h1 {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: clamp(2rem, 3vw, 2.6rem);
            line-height: 1.18;
            color: var(--primary-dark);
            margin-bottom: 1rem;
        }
        .showcase-content p { color: var(--muted); font-size: 1rem; max-width: 26rem; }

        .post-stack {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            max-width: 21rem;
        }
        .post-card {
            background: var(--paper);
            border-radius: 16px;
            padding: 1.1rem 1.3rem;
            box-shadow: 0 20px 40px -24px rgba(30, 58, 138, .35);
            transform: rotate(var(--rot, 0deg));
            animation: drift 7s ease-in-out infinite;
        }
        .post-card.card-a { --rot: -1.4deg; align-self: flex-start; animation-delay: 0s; }
        .post-card.card-b { --rot: 1.1deg; align-self: flex-end; margin-right: 1rem; animation-delay: 1.2s; }
        .post-card.card-c { --rot: -0.6deg; align-self: flex-start; margin-left: 2rem; animation-delay: 2.4s; }

        .tag {
            display: inline-block;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: .22rem .55rem;
            border-radius: 999px;
            background: rgba(29, 78, 216, .08);
            color: var(--primary-dark);
            margin-bottom: .55rem;
        }
        .post-card h3 { font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 500; margin-bottom: .35rem; color: var(--ink); }
        .post-card p { font-size: .82rem; color: var(--muted); margin-bottom: .5rem; line-height: 1.4; }
        .post-card .meta { font-size: .72rem; color: var(--primary); font-weight: 600; }

        @@keyframes drift {
            0%, 100% { transform: rotate(var(--rot, 0deg)) translateY(0); }
            50% { transform: rotate(var(--rot, 0deg)) translateY(-8px); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .post-card { animation: none; }
        }

        /* ---------- Right auth panel ---------- */
        .auth-panel { display: flex; align-items: center; justify-content: center; padding: clamp(2rem, 4vw, 3rem); }
        .auth-panel-inner { width: 100%; max-width: 23rem; }

        .brand {
            display: inline-block;
            font-family: 'Fraunces', serif;
            font-weight: 600;
            font-size: 1.3rem;
            color: var(--primary-dark);
            margin-bottom: 2.5rem;
        }

        .auth-panel-inner h2 { font-family: 'Fraunces', serif; font-weight: 500; font-size: 1.9rem; color: var(--ink); margin-bottom: .4rem; }
        .subhead { color: var(--muted); font-size: .95rem; margin-bottom: 1.8rem; }

        .btn-google {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .6rem;
            padding: .75rem 1rem;
            border-radius: 12px;
            border: 1px solid var(--line);
            background: var(--paper);
            font-size: .9rem;
            font-weight: 600;
            color: var(--ink);
            transition: box-shadow .15s ease, border-color .15s ease;
        }
        .btn-google:hover { border-color: var(--primary-light); box-shadow: 0 8px 20px -12px rgba(29, 78, 216, .35); }

        .divider {
            display: flex;
            align-items: center;
            gap: .8rem;
            margin: 1.6rem 0;
            color: var(--muted);
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }

        .field { margin-bottom: 1.15rem; }
        .field label { display: block; font-size: .82rem; font-weight: 600; color: var(--ink); margin-bottom: .4rem; }
        .input-wrap { position: relative; display: flex; align-items: center; }
        .input-wrap i { position: absolute; left: .95rem; color: var(--muted); font-size: .95rem; }
        .input-wrap input {
            width: 100%;
            padding: .75rem 1rem .75rem 2.6rem;
            border-radius: 12px;
            border: 1px solid var(--line);
            background: var(--field-bg);
            font-size: .9rem;
            color: var(--ink);
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }
        .input-wrap input::placeholder { color: #9AA7BD; }
        .input-wrap input:focus {
            outline: none;
            border-color: var(--primary-light);
            background: var(--paper);
            box-shadow: 0 0 0 4px rgba(59, 130, 246, .14);
        }
        .toggle-visibility { position: absolute; right: .85rem; background: none; border: none; color: var(--muted); padding: .2rem; display: flex; }
        .toggle-visibility:hover { color: var(--primary); }

        .field-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.6rem; flex-wrap: wrap; gap: .6rem; }

        .switch { display: flex; align-items: center; gap: .55rem; cursor: pointer; }
        .switch input { position: absolute; opacity: 0; width: 0; height: 0; }
        .switch .slider { width: 34px; height: 20px; border-radius: 999px; background: #CBD8ED; position: relative; transition: background .15s ease; flex-shrink: 0; }
        .switch .slider::before {
            content: '';
            position: absolute;
            top: 2px; left: 2px;
            width: 16px; height: 16px;
            border-radius: 50%;
            background: #fff;
            transition: transform .15s ease;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
        }
        .switch input:checked + .slider { background: var(--primary); }
        .switch input:checked + .slider::before { transform: translateX(14px); }
        .switch input:focus-visible + .slider { outline: 2px solid var(--primary-light); outline-offset: 2px; }
        .switch-label { font-size: .85rem; color: var(--ink); }

        .link { font-size: .85rem; color: var(--primary); font-weight: 600; }
        .link:hover { text-decoration: underline; }

        .btn-primary {
            width: 100%;
            padding: .85rem 1rem;
            border: none;
            border-radius: 12px;
            background: var(--primary);
            color: #fff;
            font-size: .95rem;
            font-weight: 700;
            letter-spacing: .01em;
            box-shadow: 0 14px 28px -14px rgba(29, 78, 216, .55);
            transition: background .15s ease, transform .1s ease;
        }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-primary:active { transform: translateY(1px); }

        .signup { text-align: center; font-size: .85rem; color: var(--muted); margin-top: 1.8rem; }
        .signup a { color: var(--primary); font-weight: 600; }
        .signup a:hover { text-decoration: underline; }

        @@media (max-width: 960px) {
            .auth-shell { grid-template-columns: 1fr; }
            .showcase { display: none; }
            .auth-panel { padding: 3rem 1.5rem; }
        }
    </style>
</head>

<body>

    <div class="auth-shell">

        <!-- Left: editorial showcase -->
        <section class="showcase" aria-hidden="true">
            <span class="showcase-quote">&ldquo;</span>

            <div class="showcase-content">
                <span class="eyebrow">Folio</span>
                <h1>Bu Zamana Kadar<br>Nerelerdeydin.</h1>
                <p>Hemen Giriş Yap ve Neler Kaçırdığına Göz At.</p>
            </div>

            <div class="post-stack">
                <article class="post-card card-a">
                    <span class="tag">MODA</span>
                    <h3>Ünlü Markadan Yeni Tasarım</h3>
                    <p>Dünyaca ünlü markadan herkesi şaşırtan tasarım.</p>
                    <span class="meta">4 dakika önce</span>
                </article>
                <article class="post-card card-b">
                    <span class="tag">YAŞAM</span>
                    <h3>Uyku Kalitesi</h3>
                    <p>Uyuduğunuz ve uyandığınız odanın ne kadar güneş aldığı önemli mi?</p>
                    <span class="meta">6 dakika önce</span>
                </article>
                <article class="post-card card-c">
                    <span class="tag">TEKNOLOJİ</span>
                    <h3>Yapay Zeka Savaşı</h3>
                    <p>Teknoloji firmalarından yapay zeka için emin adımlar.</p>
                    <span class="meta">3 dakika önce</span>
                </article>
            </div>
        </section>

        <!-- Right: sign-in form -->
        <section class="auth-panel">
            <div class="auth-panel-inner">
                <a class="brand" href="/">Folio</a>

                <h2>Tekrar Hoş Geldin!</h2>
                <p class="subhead">Giriş Yap ve Okumaya Başla.</p>

                <a class="btn-google" href="javascript:;">
                    <img src="assets/images/icons/search.svg" width="18" alt="" />
                    <span>Google ile Devam Et</span>
                </a>

                <div class="divider"><span>veya email ile giriş yap</span></div>

                <form class="form-body">
                    <div class="field">
                        <label for="inputEmailAddress">Mail Adresi</label>
                        <div class="input-wrap">
                            <i class="bi bi-envelope"></i>
                            <input type="email" class="form-control" id="inputEmailAddress" placeholder="mailadresin@@mail.com" required>
                        </div>
                    </div>

                    <div class="field">
                        <label for="inputChoosePassword">Şifre</label>
                        <div class="input-wrap">
                            <i class="bi bi-lock"></i>
                            <input type="password" class="form-control" id="inputChoosePassword" placeholder="••••••••" required>
                            <button type="button" class="toggle-visibility" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="field-row">
                        <label class="switch">
                            <input type="checkbox" id="flexSwitchCheckChecked" checked>
                            <span class="slider"></span>
                            <span class="switch-label">Beni Hatırla</span>
                        </label>
                        <a href="authentication-forgot-password.html" class="link">Şifreni mi Unuttun?</a>
                    </div>

                    <button type="submit" class="btn-primary">Giriş Yap</button>

                    <p class="signup">Hesabın Yok mu? <a href="authentication-signup.html">Hesap Oluştur</a></p>
                </form>
            </div>
        </section>

    </div>

    <script>
        document.querySelectorAll('.toggle-visibility').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var icon = btn.querySelector('i');
                var showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                icon.classList.toggle('bi-eye', showing);
                icon.classList.toggle('bi-eye-slash', !showing);
                btn.setAttribute('aria-label', showing ? 'Şireyi Göster' : 'Şifreyi Gizle');
            });
        });
    </script>

</body>

</html>
