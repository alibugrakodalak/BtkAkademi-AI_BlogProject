
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 — Bu yazı mürekkebe karıştı</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Space+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#131d29;
    --bg-soft:#1a2734;
    --paper:#f6f1e3;
    --paper-dim:#ded6c0;
    --ink:#1f2a3d;
    --ink-soft:#5a6a80;
    --red:#c1432f;
    --red-soft:#e07a63;
    --mustard:#e8ac3e;
    --line:rgba(255,255,255,0.05);
    --focus:#e8ac3e;
  }

  *{ box-sizing:border-box; }

  html,body{
    margin:0;
    padding:0;
    min-height:100%;
    background:var(--bg);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    overflow-x:hidden;
  }

  body{
    background-image:
      repeating-linear-gradient(var(--line) 0 1px, transparent 1px 32px),
      radial-gradient(ellipse at 50% 20%, rgba(255,255,255,0.05), transparent 60%);
    background-attachment:fixed;
  }

  a{ color:inherit; }

  .visually-hidden{
    position:absolute !important;
    width:1px; height:1px;
    padding:0; margin:-1px;
    overflow:hidden;
    clip:rect(0,0,0,0);
    white-space:nowrap;
    border:0;
  }

  :focus-visible{
    outline:3px solid var(--focus);
    outline-offset:3px;
    border-radius:4px;
  }

  /* ---------- top strip ---------- */
  .topline{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:1.5rem clamp(1.25rem, 5vw, 3rem);
    font-size:0.72rem;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--ink-soft);
  }
  .topline span:last-child{ opacity:0.7; }

  /* ---------- stage ---------- */
  .stage{
    position:relative;
    min-height:calc(100vh - 64px);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:2rem clamp(1.25rem, 6vw, 3rem) 5rem;
    text-align:center;
    isolation:isolate;
  }

  .eyebrow{
    font-size:0.75rem;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--mustard);
    margin-bottom:1.75rem;
    opacity:0;
    animation:rise 0.7s ease forwards;
  }

  /* ---------- torn paper card + ink mark ---------- */
  .card-wrap{
    position:relative;
    margin-bottom:1.25rem;
  }

  .card{
    position:relative;
    background:var(--paper);
    color:var(--ink);
    width:min(340px, 80vw);
    padding:2.6rem 1.5rem 3.2rem;
    transform:rotate(-2.5deg);
    box-shadow:0 18px 40px rgba(0,0,0,0.35);
    clip-path:polygon(
      0% 0%, 100% 0%, 100% 100%,
      95% 95%, 90% 100%, 85% 94%, 80% 99%,
      75% 94%, 70% 100%, 65% 95%, 60% 99%,
      55% 94%, 50% 100%, 45% 95%, 40% 99%,
      35% 94%, 30% 100%, 25% 95%, 20% 99%,
      15% 94%, 10% 100%, 5% 95%, 0% 99%
    );
    opacity:0;
    animation:rise 0.8s 0.15s ease forwards;
  }

  .card::before{
    content:"";
    position:absolute;
    inset:0;
    background:
      radial-gradient(circle at 20% 30%, rgba(0,0,0,0.05), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(0,0,0,0.04), transparent 45%);
    pointer-events:none;
  }

  .mark{
    position:relative;
    width:100%;
    aspect-ratio:1/1;
    max-width:220px;
    margin:0 auto;
  }

  .mark svg{ width:100%; height:100%; overflow:visible; }

  .scribble{
    fill:none;
    stroke:var(--red);
    stroke-width:5;
    stroke-linecap:round;
    stroke-dasharray:620;
    stroke-dashoffset:620;
    animation:draw 1.1s 0.5s cubic-bezier(.65,.05,.36,1) forwards;
    transform-origin:50% 50%;
  }
  .card:hover .scribble{
    animation:draw 1.1s cubic-bezier(.65,.05,.36,1) forwards, wiggle 0.5s ease 1;
  }

  .mark-number{
    position:absolute;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(2.6rem, 9vw, 3.4rem);
    color:var(--ink);
    letter-spacing:-0.02em;
  }

  .drip{
    fill:var(--red);
    opacity:0;
    animation:drip 2.6s ease-in infinite;
  }
  .drip:nth-child(2){ animation-delay:0.6s; }
  .drip:nth-child(3){ animation-delay:1.4s; }

  .stamp{
    position:absolute;
    top:0.4rem;
    right:0.6rem;
    font-family:'Space Mono', monospace;
    font-size:0.62rem;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--red-soft);
    border:1.5px solid var(--red-soft);
    padding:0.15rem 0.4rem;
    transform:rotate(6deg);
    border-radius:3px;
    opacity:0.85;
  }

  /* ---------- margin note ---------- */
  .margin-note{
    position:absolute;
    right:-9%;
    bottom:-8%;
    max-width:190px;
    text-align:left;
    font-family:'Caveat', cursive;
    font-weight:700;
    font-size:1.5rem;
    line-height:1.15;
    color:var(--red-soft);
    transform:rotate(4deg);
    opacity:0;
    animation:rise 0.7s 1.5s ease forwards;
    pointer-events:none;
  }
  .margin-note svg{
    width:46px;
    display:block;
    margin-bottom:0.15rem;
    transform:scaleX(-1) rotate(-10deg);
  }

  /* ---------- headline / body / actions ---------- */
  h1{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    font-size:clamp(1.7rem, 4.4vw, 2.5rem);
    line-height:1.15;
    max-width:20ch;
    margin:0.4rem 0 0.9rem;
    color:var(--paper);
    opacity:0;
    animation:rise 0.7s 0.9s ease forwards;
  }

  .lede{
    max-width:42ch;
    font-size:0.92rem;
    line-height:1.6;
    color:var(--ink-soft);
    margin:0 0 2.1rem;
    opacity:0;
    animation:rise 0.7s 1.05s ease forwards;
  }

  .actions{
    display:flex;
    flex-wrap:wrap;
    gap:0.9rem;
    justify-content:center;
    margin-bottom:2.6rem;
    opacity:0;
    animation:rise 0.7s 1.2s ease forwards;
  }

  .btn{
    font-family:'Space Mono', monospace;
    font-size:0.82rem;
    font-weight:700;
    letter-spacing:0.03em;
    text-decoration:none;
    padding:0.85rem 1.4rem;
    border-radius:3px;
    display:inline-flex;
    align-items:center;
    gap:0.5rem;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
  }
  .btn-primary{
    background:var(--mustard);
    color:var(--ink);
    box-shadow:0 4px 0 #a97b1f;
  }
  .btn-primary:hover{ transform:translateY(-2px); }
  .btn-primary:active{ transform:translateY(2px); box-shadow:0 1px 0 #a97b1f; }

  .btn-secondary{
    background:transparent;
    color:var(--paper);
    border:1.5px solid var(--paper-dim);
  }
  .btn-secondary:hover{ border-color:var(--paper); background:rgba(255,255,255,0.05); }

  /* ---------- search ---------- */
  .search{
    width:min(380px, 90vw);
    opacity:0;
    animation:rise 0.7s 1.35s ease forwards;
  }
  .search-label{
    font-size:0.7rem;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--ink-soft);
    margin-bottom:0.6rem;
    display:flex;
    align-items:center;
    gap:0.4rem;
    justify-content:center;
  }
  .search-row{
    display:flex;
    gap:0.5rem;
  }
  .search-row input{
    flex:1;
    background:transparent;
    border:none;
    border-bottom:1.5px solid var(--paper-dim);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    font-size:0.88rem;
    padding:0.55rem 0.2rem;
  }
  .search-row input::placeholder{ color:var(--ink-soft); }
  .search-row input:focus{ border-bottom-color:var(--mustard); }
  .search-row button{
    background:none;
    border:1.5px solid var(--paper-dim);
    color:var(--paper);
    font-family:'Space Mono', monospace;
    font-size:0.82rem;
    padding:0 1rem;
    border-radius:3px;
    cursor:pointer;
  }
  .search-row button:hover{ border-color:var(--mustard); color:var(--mustard); }

  .search-result{
    margin-top:0.9rem;
    font-size:0.8rem;
    color:var(--red-soft);
    min-height:1.2em;
  }

  /* ---------- floating scraps ---------- */
  .scrap-layer{
    position:absolute;
    inset:0;
    pointer-events:none;
    z-index:-1;
  }
  .scrap{
    position:absolute;
    background:var(--paper);
    color:var(--ink-soft);
    font-size:0.62rem;
    letter-spacing:0.03em;
    padding:0.35rem 0.55rem;
    box-shadow:0 8px 18px rgba(0,0,0,0.3);
    opacity:0.8;
    animation:float 7s ease-in-out infinite;
  }
  .scrap-1{ top:12%; left:8%;  transform:rotate(-8deg);  animation-duration:8s; }
  .scrap-2{ top:22%; right:10%; transform:rotate(6deg);  animation-duration:9.5s; animation-delay:0.4s; }
  .scrap-3{ bottom:16%; left:12%; transform:rotate(4deg); animation-duration:7.5s; animation-delay:1s; }
  .scrap-4{ bottom:10%; right:7%; transform:rotate(-5deg); animation-duration:8.6s; animation-delay:0.7s; }
  .scrap-5{ top:48%; left:3%; transform:rotate(10deg); animation-duration:9s; animation-delay:1.3s; }

  /* ---------- paper plane ---------- */
  .plane-layer{
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:5;
  }
  .plane{
    position:absolute;
    width:46px;
    top:60%;
    left:-8%;
    color:var(--paper-dim);
    animation:fly 13s linear infinite;
    animation-delay:2.5s;
  }

  /* ---------- keyframes ---------- */
  @@keyframes rise{
    from{ opacity:0; transform:translateY(14px); }
    to{ opacity:1; transform:translateY(0); }
  }
  .card{ animation-name:cardRise; }
  @@keyframes cardRise{
    from{ opacity:0; transform:rotate(-2.5deg) translateY(14px); }
    to{ opacity:1; transform:rotate(-2.5deg) translateY(0); }
  }
  @@keyframes draw{
    to{ stroke-dashoffset:0; }
  }
  @@keyframes wiggle{
    0%,100%{ transform:rotate(0deg); }
    30%{ transform:rotate(-2deg); }
    60%{ transform:rotate(2deg); }
  }
  @@keyframes drip{
    0%{ opacity:0; transform:translateY(0); }
    15%{ opacity:0.9; }
    100%{ opacity:0; transform:translateY(26px); }
  }
  @@keyframes float{
    0%,100%{ transform:translateY(0) rotate(var(--r,0deg)); }
    50%{ transform:translateY(-14px) rotate(var(--r,0deg)); }
  }
  @@keyframes fly{
    0%{ left:-8%; top:62%; transform:rotate(-6deg); opacity:0; }
    8%{ opacity:1; }
    30%{ top:38%; transform:rotate(4deg); }
    55%{ top:52%; transform:rotate(-8deg); }
    75%{ top:30%; transform:rotate(2deg); }
    92%{ opacity:1; }
    100%{ left:112%; top:20%; transform:rotate(-4deg); opacity:0; }
  }

  @@media (max-width:520px){
    .actions{ flex-direction:column; align-items:stretch; width:min(320px,80vw); }
    .margin-note{ display:none; }
    .scrap-5{ display:none; }
  }

  @@media (prefers-reduced-motion: reduce){
    *, *::before, *::after{
      animation-duration:0.01ms !important;
      animation-iteration-count:1 !important;
      transition-duration:0.01ms !important;
    }
    .eyebrow,.card,h1,.lede,.actions,.search,.margin-note{ opacity:1 !important; transform:none !important; }
    .scribble{ stroke-dashoffset:0 !important; }
    .plane{ display:none; }
  }
</style>
</head>
<body>

  <div class="topline" aria-hidden="true">
    <span>blog / 404</span>
    <span>arşiv no. ??? / kayıp</span>
  </div>

  <main class="stage">

    <h1 class="visually-hidden">404 — Sayfa bulunamadı</h1>

    <div class="scrap-layer" aria-hidden="true">
      <div class="scrap scrap-1">taslak #114</div>
      <div class="scrap scrap-2">5 dk okuma</div>
      <div class="scrap scrap-3">yayından kaldırıldı</div>
      <div class="scrap scrap-4">düzenleniyor…</div>
      <div class="scrap scrap-5">kayıt bulunamadı</div>
    </div>

    <p class="eyebrow">Düzeltmenin notu</p>

    <div class="card-wrap">
      <div class="card">
        <span class="stamp">incelendi</span>
        <div class="mark" aria-hidden="true">
          <svg viewBox="0 0 220 220">
            <path class="scribble" d="M45,70 C20,110 25,165 75,185 C130,205 190,180 195,125 C200,70 160,25 105,28 C55,31 25,55 40,75" />
            <circle class="drip" cx="70" cy="182" r="4" />
            <circle class="drip" cx="118" cy="196" r="3.5" />
            <circle class="drip" cx="150" cy="178" r="3" />
          </svg>
          <div class="mark-number">404</div>
        </div>
        <span class="visually-hidden">Hata 404</span>
      </div>

      <p class="margin-note" aria-hidden="true">
        <svg viewBox="0 0 60 40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M5 30 C 20 5, 45 5, 55 20" />
          <path d="M46 12 L 55 20 L 44 24" />
        </svg>
        bu cümle nereye gitti?
      </p>
    </div>

    <h2 style="all:unset; font-family:'Fraunces', serif; font-style:italic; font-weight:500; font-size:clamp(1.7rem, 4.4vw, 2.5rem); line-height:1.15; max-width:20ch; margin:0.4rem 0 0.9rem; color:var(--paper); opacity:0; animation:rise 0.7s 0.9s ease forwards; display:block; text-align:center;">
      Bu yazı mürekkebe karıştı.
    </h2>

    <p class="lede">
      Aradığın sayfa ya hiç yazılmadı, ya taslaklarda unutuldu, ya da bir kahve
      molasında buharlaştı. Arşivin geri kalanı yerli yerinde duruyor.
    </p>

    <div class="actions">
      <a class="btn btn-primary" href="/">← Ana Sayfaya Dön</a>
      <a class="btn btn-secondary" href="/blog">Popüler Yazılara Göz At</a>
    </div>

    <form class="search" id="searchForm">
      <label class="search-label" for="searchInput">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
        Arşivde ara
      </label>
      <div class="search-row">
        <input id="searchInput" type="text" placeholder="başlık, konu ya da yazar…" autocomplete="off">
        <button type="submit">Ara</button>
      </div>
      <p class="search-result" id="searchResult" aria-live="polite"></p>
    </form>

  </main>

  <div class="plane-layer" aria-hidden="true">
    <svg class="plane" viewBox="0 0 64 64" fill="currentColor">
      <path d="M4 32 L60 8 L38 32 L60 56 Z" opacity="0.9"/>
      <path d="M4 32 L38 32 L28 44 Z" opacity="0.6"/>
    </svg>
  </div>

  <script>
    const form = document.getElementById('searchForm');
    const input = document.getElementById('searchInput');
    const result = document.getElementById('searchResult');
    const replies = [
      q => `"${q}" da arşivde yok. Ama pes etme, ana sayfadan devam edilebilir.`,
      q => `"${q}" için bir sonuç bulamadık — belki de henüz yazılmadı.`,
      q => `"${q}" burada değil. Belki bir taslakta kayboldu.`
    ];
    form.addEventListener('submit', function(e){
      e.preventDefault();
      const q = input.value.trim();
      if(!q){
        result.textContent = 'Aramak için bir şeyler yazman gerek.';
        return;
      }
      const reply = replies[Math.floor(Math.random()*replies.length)];
      result.textContent = reply(q);
    });
  </script>

</body>
</html>