@model List<ResultLast5ArticleByCategoryDto>
<ul class="back-hero-bottom back-hero-slider2 owl-carousel">
    @foreach (var item in Model)
    {
        <li>
            <div class="image-areas">
                <a href="#"><img src="@item.FeatureSliderCategoryImage300x370Url" alt="image"></a>
            </div>
            <div class="back-btm-content">
                <a href="#" class="back-cates">@item.CategoryName</a>
                <h3>
                    <a href="#">
                        @(string.IsNullOrEmpty(item.Title)
                            ? ""
                            : item.Title.Length > 27
                                ? item.Title.Substring(0, 27) + "..."
                                : item.Title)
                    </a>
                </h3>
                <ul>
                    <li class="back-date"><span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-clock"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></span>@item.CreatedDate.ToString("dd-MMM-yyyy", new System.Globalization.CultureInfo("tr-TR"))</li>
                </ul>
            </div>
        </li>
    }
</ul>