<a href="#" class="post-author">
    <div class="avatar">
        <img src="@ViewBag.UserImage" alt="">
    </div>
    <div class="info">
        <h4 class="name">@ViewBag.AuthorNameSurname</h4>
        <span class="designation">@ViewBag.UserTitle</span>
        <p>@ViewBag.AuthorDescription</p>
    </div>
</a>