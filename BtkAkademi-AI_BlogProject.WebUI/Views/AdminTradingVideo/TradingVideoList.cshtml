@model List<ResultTradingVideoDto>

@{
    ViewData["Title"] = "TradingVideoList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .video-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .card-header-custom {
        background: #fff;
        border-bottom: 1px solid #edf2f7;
        padding: 25px;
    }

    .page-title {
        font-weight: 700;
        color: #344767;
    }

    .stat-badge {
        background: #eef4ff;
        color: #0d6efd;
        padding: 8px 14px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
    }

    .search-box {
        position: relative;
    }

        .search-box i {
            position: absolute;
            top: 50%;
            left: 16px;
            transform: translateY(-50%);
            color: #6c757d;
        }

        .search-box input {
            height: 48px;
            border-radius: 12px;
            padding-left: 45px;
            border: 1px solid #dee2e6;
        }

            .search-box input:focus {
                box-shadow: none;
                border-color: #0d6efd;
            }

    .modern-table thead {
        background: #f8fafc;
    }

        .modern-table thead th {
            border: none;
            font-weight: 600;
            color: #344767;
            padding: 18px;
        }

    .modern-table tbody td {
        padding: 18px;
        border-color: #edf2f7;
        vertical-align: middle;
    }

    .modern-table tbody tr {
        transition: all .25s ease;
    }

        .modern-table tbody tr:hover {
            background: #f8fafc;
        }

    .video-id {
        background: #f1f5f9;
        color: #475569;
        padding: 7px 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
    }

    .video-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #344767;
    }

    .video-icon {
        color: #dc3545;
        font-size: 16px;
    }

    .date-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        color: #64748b;
        padding: 6px 12px;
        border-radius: 10px;
        font-weight: 500;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .25s;
    }

        .action-btn:hover {
            transform: translateY(-2px);
        }

    .btn-view {
        background: rgba(13,110,253,.12);
        color: #0d6efd;
    }

    .btn-edit {
        background: rgba(255,193,7,.18);
        color: #ff9800;
    }

    .btn-delete {
        background: rgba(220,53,69,.12);
        color: #dc3545;
    }
</style>

<main class="page-content">

    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
        <div class="breadcrumb-title pe-3 fw-bold">
            Video Makaleler
        </div>

        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#">
                            <i class="bx bx-home-alt"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Video İçerikli Makale Listesi
                    </li>
                </ol>
            </nav>
        </div>

        <div class="ms-auto">
            <a href="/AdminTradingVideo/CreateTradingVideo/"
                   class="btn btn-primary px-4">
                <i class="bi bi-plus-circle me-2"></i>
                Yeni Video Makale
            </a>
        </div>
    </div>

    <div class="card video-card">

        <div class="card-header-custom">
            <div class="row align-items-center">

                <div class="col-lg-6">
                    <h4 class="page-title mb-2">
                        <i class="bi bi-play-btn-fill text-danger me-2"></i>
                        Video Makaleler
                    </h4>
                </div>

                <div class="col-lg-4 ms-auto mt-3 mt-lg-0">
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               id="searchInput"
                               class="form-control"
                               placeholder="Video makale ara..." />
                    </div>
                </div>

            </div>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table modern-table mb-0"
                       id="videoTable">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Başlık</th>
                            <th>Oluşturulma Tarihi</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <span class="video-id">
                                        #@item.TradingVideoId
                                    </span>
                                </td>

                                <td>
                                    <div class="video-title">
                                        <i class="bi bi-camera-video-fill video-icon"></i>
                                        @item.Title
                                    </div>
                                </td>

                                <td>
                                    <span class="date-badge">
                                        <i class="bi bi-calendar-event"></i>
                                        @item.CreatedDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                    </span>
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a href="/Default/Index/"
                                               class="action-btn btn-view"
                                               data-bs-toggle="tooltip"
                                               title="Makaleyi Aç">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>

                                        <a href="/AdminTradingVideo/UpdateTradingVideo/@item.TradingVideoId"
                                               class="action-btn btn-edit"
                                               data-bs-toggle="tooltip"
                                               title="Düzenle">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        <a href="/AdminTradingVideo/RemoveTradingVideo/@item.TradingVideoId"
                                               class="action-btn btn-delete"
                                               data-bs-toggle="tooltip"
                                               title="Sil">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</main>

<script>
    document.getElementById("searchInput")
        .addEventListener("keyup", function () {

            let value = this.value.toLowerCase();
            let rows = document.querySelectorAll("#videoTable tbody tr");

            rows.forEach(function (row) {

                let text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(value) ? "" : "none";
            });
        });
</script>