@model BtkAkademi_AI_BlogProject.WebUI.DTO_s.ContactDtos.GetContactByIdDto

@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>
    .form-card {
        max-width: 700px;
        margin: auto;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .form-header {
        padding: 25px;
        background: linear-gradient(135deg,#0d6efd,#3d8bfd);
        color: white;
    }

    .form-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .form-subtitle {
        opacity: .8;
    }

    .modern-input {
        height: 55px;
        border-radius: 12px;
        border: 1px solid #dee2e6;
    }

        .modern-input:focus {
            box-shadow: none;
            border-color: #0d6efd;
        }

    textarea.modern-input {
        height: auto;
        min-height: 120px;
        resize: vertical;
    }

    .save-btn {
        height: 50px;
        border-radius: 12px;
        font-weight: 600;
    }
</style>

<main class="page-content">

    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">
        <div class="breadcrumb-title pe-3">
            İletişim Bilgileri
        </div>

        <div class="ps-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <i class="bx bx-home-alt"></i>
                </li>
                <li class="breadcrumb-item active">
                    İletişim Bilgisi Güncelle
                </li>
            </ol>
        </div>
    </div>

    <div class="card form-card">

        <div class="form-header">
            <div class="form-title">
                <i class="bi bi-folder-plus me-2"></i>
                Yeni İletişim Bilgisi Güncelle
            </div>
        </div>

        <div class="card-body p-4">

            <form method="post">

                <input type="hidden" asp-for="ContactId" />

                <div class="mb-3">
                    <label asp-for="PhoneNumberFirst" class="form-label fw-semibold">Telefon No1</label>
                    <input type="text" asp-for="PhoneNumberFirst" class="form-control modern-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumberSecond" class="form-label fw-semibold">Telefon No2</label>
                    <input type="text" asp-for="PhoneNumberSecond" class="form-control modern-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="FirstEmail" class="form-label fw-semibold">Mail Adres1</label>
                    <input type="email" asp-for="FirstEmail" class="form-control modern-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="SecondEmail" class="form-label fw-semibold">Mail Adres2</label>
                    <input type="email" asp-for="SecondEmail" class="form-control modern-input" />
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label fw-semibold">Adres</label>
                    <input type="text" asp-for="Address" class="form-control modern-input" placeholder="Örn: Avcılar/İstanbul" />
                </div>

                <div class="mb-3">
                    <label asp-for="MapLocation" class="form-label fw-semibold">Konum</label>
                    <input type="text" asp-for="MapLocation" class="form-control modern-input" placeholder="Google Maps Harita Konumu" />
                </div>

                <div class="mb-3">
                    <label asp-for="Description1" class="form-label fw-semibold">Açıklama1</label>
                    <textarea rows="5" asp-for="Description1" class="form-control modern-input"></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Description2" class="form-label fw-semibold">Açıklama2</label>
                    <textarea rows="5" asp-for="Description2" class="form-control modern-input"></textarea>
                </div>

                <button type="submit" class="btn btn-success save-btn w-100">
                    <i class="bi bi-check-circle me-2"></i>
                    Güncelle
                </button>

            </form>

        </div>

    </div>

</main>


