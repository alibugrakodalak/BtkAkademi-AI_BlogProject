@{
    ViewData["Title"] = "CheckToxicity";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<style>

    .toxicity-card {
        border: none;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
    }

    .toxicity-header {
        background: linear-gradient(135deg,#10b981,#059669);
        padding: 30px;
        color: white;
    }

    .toxicity-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .toxicity-subtitle {
        opacity: .9;
        font-size: 14px;
    }

    .custom-textarea {
        min-height: 180px;
        border-radius: 16px;
        border: 1px solid #dee2e6;
        resize: vertical;
        padding: 15px;
    }

        .custom-textarea:focus {
            border-color: #10b981;
            box-shadow: none;
        }

    .btn-analyze {
        background: linear-gradient(135deg,#10b981,#059669);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 26px;
        font-weight: 600;
    }

        .btn-analyze:hover {
            color: white;
            opacity: .95;
        }

    .result-card {
        border-radius: 18px;
        padding: 24px;
        border: none;
        height: 100%;
    }

    .result-success {
        background: linear-gradient(135deg,#ecfdf5,#d1fae5);
    }

    .result-danger {
        background: linear-gradient(135deg,#fef2f2,#fee2e2);
    }

    .score-box {
        background: white;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
        transition: .3s;
        height: 100%;
    }

        .score-box:hover {
            transform: translateY(-4px);
        }

    .score-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 24px;
        margin-bottom: 12px;
    }

    .score-title {
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
    }

    .score-value {
        font-size: 28px;
        font-weight: 700;
        margin-top: 8px;
    }

    .bg-toxic {
        background: rgba(239,68,68,.12);
        color: #ef4444;
    }

    .bg-warning-soft {
        background: rgba(245,158,11,.12);
        color: #f59e0b;
    }

    .bg-success-soft {
        background: rgba(16,185,129,.12);
        color: #10b981;
    }

    .analysis-text {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 20px;
        line-height: 1.8;
        color: #475569;
    }

    .model-info {
        border-radius: 18px;
        border: none;
        overflow: hidden;
    }

    .accordion-button:not(.collapsed) {
        background: #ecfdf5;
        color: #059669;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
    }

    .summary-score {
        text-align: center;
    }

        .summary-score h1 {
            font-size: 60px;
            font-weight: 800;
            margin-bottom: 0;
        }

        .summary-score p {
            color: #64748b;
            margin-bottom: 0;
        }

</style>

<main class="page-content">

    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-4">

        <div class="breadcrumb-title pe-3">
            AI Moderasyon
        </div>

        <div class="ps-3">
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="#">
                            <i class="bx bx-home-alt"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Toksiklik Analizi
                    </li>
                </ol>
            </nav>
        </div>

    </div>

    <div class="card toxicity-card">

        <div class="toxicity-header">

            <div class="d-flex align-items-center gap-3">

                <i class="bi bi-shield-check fs-1"></i>

                <div>

                    <div class="toxicity-title">
                        AI Toksiklik Analizi
                    </div>

                    <div class="toxicity-subtitle">
                        BERT modeli ile yorum ve metinlerde toksik içerik tespiti yapın.
                    </div>

                </div>

            </div>

        </div>

        <div class="card-body p-4">

            <form method="post">

                <label class="fw-semibold mb-2">
                    Analiz Edilecek Metin
                </label>

                <textarea class="form-control custom-textarea"
                          id="CommentText"
                          name="CommentText"
                          placeholder="Analiz edilecek metni giriniz..."
                          required>@ViewBag.OriginalText</textarea>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-analyze">

                        <i class="bi bi-search me-2"></i>
                        Analizi Başlat

                    </button>

                </div>

            </form>
            @if (ViewBag.Success == true)
            {
                <div class="mt-5">

                    <div class="result-card result-success mb-4">

                        <div class="row align-items-center">

                            <div class="col-lg-6">

                                <div class="summary-score">

                                    <h1>
                                        %@Math.Round(ViewBag.MaxScore * 100, 0)
                                    </h1>

                                    <p>Genel Risk Skoru</p>

                                </div>

                            </div>

                            <div class="col-lg-6">

                                <h4 class="fw-bold">
                                    @ViewBag.ToxicityLevel
                                </h4>

                                <span class="badge bg-@ViewBag.LevelColor fs-6">
                                    @ViewBag.MaxLabel
                                </span>

                                <div class="mt-3 text-muted">
                                    Model tarafından tespit edilen en yüksek risk kategorisi.
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="row g-4">

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-toxic">
                                    ☢
                                </div>
                                <div class="score-title">Toxic</div>
                                <div class="score-value text-danger">
                                    %@ViewBag.ToxicPercent
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-toxic">
                                    ☠
                                </div>
                                <div class="score-title">Severe Toxic</div>
                                <div class="score-value text-danger">
                                    %@ViewBag.SevereToxicPercent
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-warning-soft">
                                    🚫
                                </div>
                                <div class="score-title">Obscene</div>
                                <div class="score-value text-warning">
                                    %@ViewBag.ObscenePercent
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-toxic">
                                    ⚡
                                </div>
                                <div class="score-title">Threat</div>
                                <div class="score-value text-danger">
                                    %@ViewBag.ThreatPercent
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-warning-soft">
                                    😡
                                </div>
                                <div class="score-title">Insult</div>
                                <div class="score-value text-warning">
                                    %@ViewBag.InsultPercent
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="score-box">
                                <div class="score-icon bg-toxic">
                                    👤
                                </div>
                                <div class="score-title">Identity Hate</div>
                                <div class="score-value text-danger">
                                    %@ViewBag.IdentityHatePercent
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="mt-4">

                        <div class="card border-0 shadow-sm">

                            <div class="card-header bg-light">

                                <strong>
                                    Analiz Edilen Metin
                                </strong>

                            </div>

                            <div class="card-body">

                                <div class="analysis-text">

                                    @ViewBag.OriginalText

                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            }

            @if (ViewBag.Success == false)
            {
                <div class="mt-4">

                    <div class="result-card result-danger">

                        <h5 class="fw-bold text-danger">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Analiz Başarısız
                        </h5>

                        <p class="mb-1">
                            @ViewBag.Error
                        </p>

                        @if (!string.IsNullOrEmpty(ViewBag.Message))
                        {
                            <p class="text-muted mb-0">
                                @ViewBag.Message
                            </p>
                        }

                    </div>

                </div>
            }

            <div class="accordion mt-4 model-info">

                <div class="accordion-item">

                    <h2 class="accordion-header">

                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#modelInfo">

                            Model Hakkında

                        </button>

                    </h2>

                    <div id="modelInfo"
                         class="accordion-collapse collapse">

                        <div class="accordion-body">

                            <strong>
                                unitary/toxic-bert
                            </strong>

                            <hr />

                            <ul class="mb-0">

                                <li>Toxic - Genel toksik içerik</li>

                                <li>Severe Toxic - Ağır toksik içerik</li>

                                <li>Obscene - Müstehcen içerik</li>

                                <li>Threat - Tehdit içeren ifadeler</li>

                                <li>Insult - Hakaret içeren içerik</li>

                                <li>Identity Hate - Kimlik temelli nefret söylemi</li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</main>