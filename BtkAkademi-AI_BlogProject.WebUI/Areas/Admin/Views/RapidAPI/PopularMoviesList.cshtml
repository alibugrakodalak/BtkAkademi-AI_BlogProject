@model List<RapidAPIMoviesModel>

@{
    ViewData["Title"] = "PopularMoviesList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<main class="page-content">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0">Popüler Filmler</h3>
            <span class="badge bg-primary">@Model.Count film</span>
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-warning">
                Şu anda gösterilecek film bulunamadı.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var movie in Model)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm">
                            <img src="@movie.primaryImage"
                                 class="card-img-top"
                                 alt="@movie.primaryTitle"
                                 style="height: 350px; object-fit: cover;"
                                 onerror="this.src='https://via.placeholder.com/300x450?text=Resim+Yok';" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@movie.primaryTitle</h5>
                                @if (movie.originalTitle != movie.primaryTitle)
                                {
                                    <h6 class="card-subtitle mb-2 text-muted">@movie.originalTitle</h6>
                                }
                                <p class="card-text small flex-grow-1">
                                    @(movie.description?.Length > 120
                                        ? movie.description.Substring(0, 120) + "..."
                                        : movie.description)
                                </p>
                                <a href="@movie.url" target="_blank" class="btn btn-outline-primary btn-sm mt-auto">
                                    IMDb'de Görüntüle
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>
