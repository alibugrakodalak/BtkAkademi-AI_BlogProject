@model GetSocialMediaByIdDto

@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">

<main class="page-content">
<div class="smxc-wrap">

    <div class="smxc-header">
        <div>
            <a href="@Url.Action("SocialMediaList", "SocialMedia", new { area = "Admin" })" class="smxc-back">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M11 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Listeye dön
            </a>
            <h1 class="smxc-title">Sosyal Medya Hesabını Düzenle</h1>
            <p class="smxc-subtitle">Bilgileri güncelleyin — sağda sitede nasıl görüneceğini canlı olarak izleyin.</p>
        </div>
    </div>

    <div class="smxc-grid">

        <form asp-action="UpdateSocialMedia" asp-controller="SocialMedia" asp-area="Admin" method="post" class="smxc-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SocialMediaId" />
            <div asp-validation-summary="ModelOnly" class="smxc-summary"></div>

            <div class="smxc-field">
                <label class="smxc-label">Platform (hızlı seçim)</label>
                <div class="smxc-chips" id="smxcChips">
                    <button type="button" class="smxc-chip" data-platform="instagram" data-icon="fa-brands fa-instagram" data-img="/images/socialMedia/instagram.png" data-link="https://www.instagram.com/">
                        <i class="fa-brands fa-instagram"></i> Instagram
                    </button>
                    <button type="button" class="smxc-chip" data-platform="facebook" data-icon="fa-brands fa-facebook" data-img="/images/socialMedia/facebook.png" data-link="https://www.facebook.com/">
                        <i class="fa-brands fa-facebook"></i> Facebook
                    </button>
                    <button type="button" class="smxc-chip" data-platform="x" data-icon="fa-brands fa-twitter" data-img="/images/socialMedia/x.png" data-link="https://www.x.com/">
                        <i class="fa-brands fa-twitter"></i> X
                    </button>
                    <button type="button" class="smxc-chip" data-platform="youtube" data-icon="fa-brands fa-youtube" data-img="/images/socialMedia/yt.png" data-link="https://www.youtube.com/">
                        <i class="fa-brands fa-youtube"></i> YouTube
                    </button>
                    <button type="button" class="smxc-chip" data-platform="linkedin" data-icon="fa-brands fa-linkedin" data-img="/images/socialMedia/linkedin.png" data-link="https://www.linkedin.com/">
                        <i class="fa-brands fa-linkedin"></i> LinkedIn
                    </button>
                    <button type="button" class="smxc-chip" data-platform="tiktok" data-icon="fa-brands fa-tiktok" data-img="/images/socialMedia/tiktok.png" data-link="https://www.tiktok.com/">
                        <i class="fa-brands fa-tiktok"></i> TikTok
                    </button>
                </div>
                <span class="smxc-hint">Bir platform seçmek ikon alanını değiştirir; görsel/bağlantı sadece boşsa doldurulur.</span>
            </div>

            <div class="smxc-field">
                <label class="smxc-label" for="ImageUrl400x300">Görsel Yolu <span class="smxc-req">*</span></label>
                <input asp-for="ImageUrl400x300" id="ImageUrl400x300" class="smxc-input" placeholder="/images/socialMedia/instagram.png" autocomplete="off" />
                <span asp-validation-for="ImageUrl400x300" class="smxc-error"></span>
                <span class="smxc-hint">400x300 oranında, sunucudaki dosya yolu.</span>
            </div>

            <div class="smxc-field">
                <label class="smxc-label" for="IconUrl">İkon Sınıfı <span class="smxc-req">*</span></label>
                <input asp-for="IconUrl" id="IconUrl" class="smxc-input smxc-input-mono" placeholder="fa-brands fa-instagram" autocomplete="off" />
                <span asp-validation-for="IconUrl" class="smxc-error"></span>
                <span class="smxc-hint">Font Awesome ikon class'ı (fontawesome.com/icons üzerinden bulabilirsin).</span>
            </div>

            <div class="smxc-field">
                <label class="smxc-label" for="SocialMediaLink">Bağlantı <span class="smxc-req">*</span></label>
                <input asp-for="SocialMediaLink" id="SocialMediaLink" type="url" class="smxc-input smxc-input-mono" placeholder="https://www.instagram.com/hesap-adi" autocomplete="off" />
                <span asp-validation-for="SocialMediaLink" class="smxc-error"></span>
            </div>

            <div class="smxc-actions">
                <button type="submit" class="smxc-btn smxc-btn-primary">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Güncelle
                </button>
                <a href="@Url.Action("SocialMediaList", "SocialMedia", new { area = "Admin" })" class="smxc-btn smxc-btn-ghost">İptal</a>
                <button type="button" class="smxc-btn smxc-btn-danger" onclick="smxuConfirmDelete(@Model.SocialMediaId)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Sil
                </button>
            </div>
        </form>

        <div class="smxc-preview-col">
            <span class="smxc-preview-label">Önizleme</span>
            <div class="smx-card platform-default" id="smxcPreviewCard">
                <span class="smx-topbar"></span>
                <div class="smx-media">
                    <img id="smxcPreviewImg" src="" alt="Önizleme görseli" style="display:none;" />
                    <div class="smxc-media-placeholder" id="smxcMediaPlaceholder">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M3 15l5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                        <span>Görsel yolu girildikçe burada görünecek</span>
                    </div>
                    <span class="smx-icon-badge">
                        <i id="smxcPreviewIcon"></i>
                    </span>
                </div>
                <div class="smx-body">
                    <a class="smx-link" id="smxcPreviewLink" href="#" target="_blank" rel="noopener noreferrer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" class="smx-link-ic"><path d="M14 5h5v5M19 5l-8 8M9 5H6a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span id="smxcPreviewLinkText">Bağlantı burada görünecek</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
</main>

<form id="smxuDeleteForm" asp-action="Delete" asp-controller="SocialMedia" asp-area="Admin" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="smxuDeleteId" />
</form>

<style>
    .smxc-wrap{
        --smx-canvas:#f3f4f7;
        --smx-surface:#ffffff;
        --smx-ink:#16181f;
        --smx-muted:#6c7280;
        --smx-line:#e6e8ee;
        --smx-accent:#3457d5;
        --smx-danger:#d92d20;
        font-family:'Inter',system-ui,sans-serif;
        color:var(--smx-ink);
        padding:28px 4px 48px;
    }
    .smxc-wrap *{ box-sizing:border-box; }

    .smxc-back{
        display:inline-flex;
        align-items:center;
        gap:6px;
        font-size:13px;
        font-weight:600;
        color:var(--smx-muted);
        text-decoration:none;
        margin-bottom:14px;
    }
    .smxc-back:hover{ color:var(--smx-accent); }

    .smxc-title{
        font-family:'Sora',sans-serif;
        font-weight:800;
        font-size:24px;
        letter-spacing:-0.02em;
        margin:0 0 6px;
    }
    .smxc-subtitle{ margin:0 0 28px; color:var(--smx-muted); font-size:14px; max-width:520px; }

    .smxc-grid{
        display:grid;
        grid-template-columns:1fr 320px;
        gap:28px;
        align-items:start;
    }

    .smxc-form{
        background:var(--smx-surface);
        border:1px solid var(--smx-line);
        border-radius:16px;
        padding:26px;
        display:flex;
        flex-direction:column;
        gap:20px;
    }

    .smxc-summary{ color:var(--smx-danger); font-size:13px; }
    .smxc-summary ul{ margin:0; padding-left:18px; }

    .smxc-field{ display:flex; flex-direction:column; gap:6px; }
    .smxc-label{ font-size:13.5px; font-weight:600; color:var(--smx-ink); }
    .smxc-req{ color:var(--smx-danger); }

    .smxc-input{
        font-family:'Inter',sans-serif;
        font-size:14px;
        padding:11px 13px;
        border-radius:10px;
        border:1px solid var(--smx-line);
        background:var(--smx-canvas);
        color:var(--smx-ink);
        outline:none;
        transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .smxc-input-mono{ font-family:'JetBrains Mono',monospace; font-size:13px; }
    .smxc-input:focus{
        border-color:var(--smx-accent);
        background:#fff;
        box-shadow:0 0 0 3px rgba(52,87,213,.14);
    }
    .smxc-hint{ font-size:12px; color:var(--smx-muted); }
    .smxc-error{ font-size:12px; color:var(--smx-danger); }

    .smxc-chips{ display:flex; flex-wrap:wrap; gap:8px; }
    .smxc-chip{
        display:inline-flex;
        align-items:center;
        gap:7px;
        font-family:'Inter',sans-serif;
        font-size:12.5px;
        font-weight:600;
        color:var(--smx-muted);
        background:var(--smx-canvas);
        border:1px solid var(--smx-line);
        border-radius:999px;
        padding:7px 14px 7px 10px;
        cursor:pointer;
        transition:border-color .15s ease, color .15s ease, background .15s ease;
    }
    .smxc-chip i{ font-size:14px; }
    .smxc-chip:hover{ border-color:var(--smx-accent); color:var(--smx-ink); }
    .smxc-chip.is-active{ border-color:var(--smx-accent); background:rgba(52,87,213,.08); color:var(--smx-accent); }

    .smxc-actions{ display:flex; align-items:center; gap:10px; margin-top:6px; }
    .smxc-btn{
        display:inline-flex;
        align-items:center;
        gap:8px;
        border:none;
        cursor:pointer;
        text-decoration:none;
        font-family:'Inter',sans-serif;
        font-weight:600;
        font-size:14px;
        padding:11px 20px;
        border-radius:10px;
        transition:transform .15s ease, background .15s ease;
    }
    .smxc-btn-primary{ background:var(--smx-ink); color:#fff; }
    .smxc-btn-primary:hover{ background:var(--smx-accent); transform:translateY(-1px); }
    .smxc-btn-ghost{ background:transparent; color:var(--smx-muted); border:1px solid var(--smx-line); }
    .smxc-btn-ghost:hover{ color:var(--smx-ink); background:var(--smx-canvas); }
    .smxc-btn-danger{ background:transparent; color:var(--smx-danger); border:1px solid #f6c6c1; margin-left:auto; }
    .smxc-btn-danger:hover{ background:#fdeceb; }

    .smxc-preview-col{ position:sticky; top:20px; display:flex; flex-direction:column; gap:10px; }
    .smxc-preview-label{ font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--smx-muted); }

    /* --- reused card styles (kept identical to the list page) --- */
    .smx-card{
        position:relative;
        background:var(--smx-surface);
        border:1px solid var(--smx-line);
        border-radius:16px;
        overflow:hidden;
    }
    .smx-card.platform-instagram{ --smx-accent:#dd2a7b; --smx-accent-2:#f58529; }
    .smx-card.platform-facebook { --smx-accent:#1877f2; --smx-accent-2:#1877f2; }
    .smx-card.platform-x        { --smx-accent:#111318; --smx-accent-2:#3a3f4b; }
    .smx-card.platform-youtube  { --smx-accent:#ff0000; --smx-accent-2:#ff0000; }
    .smx-card.platform-linkedin { --smx-accent:#0a66c2; --smx-accent-2:#0a66c2; }
    .smx-card.platform-tiktok   { --smx-accent:#000000; --smx-accent-2:#25f4ee; }
    .smx-card.platform-default  { --smx-accent:#3457d5; --smx-accent-2:#3457d5; }
    .smx-topbar{ display:block; height:3px; background:linear-gradient(90deg, var(--smx-accent), var(--smx-accent-2)); }
    .smx-media{ position:relative; width:100%; aspect-ratio:4/3; background:var(--smx-canvas); overflow:hidden; }
    .smx-media img{ width:100%; height:100%; object-fit:cover; display:block; }
    .smxc-media-placeholder{
        position:absolute; inset:0;
        display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px;
        color:var(--smx-muted); text-align:center; padding:20px; font-size:12px;
    }
    .smx-icon-badge{
        position:absolute; left:14px; bottom:-16px; width:40px; height:40px; border-radius:50%;
        background:#fff; display:flex; align-items:center; justify-content:center;
        box-shadow:0 0 0 3px #fff, 0 0 0 5px var(--smx-accent), 0 6px 12px -4px rgba(20,22,31,.35);
    }
    .smx-icon-badge i{ font-size:17px; color:var(--smx-accent); line-height:1; }
    .smx-body{ padding:24px 16px 18px; }
    .smx-link{
        display:flex; align-items:center; gap:6px;
        font-family:'JetBrains Mono',monospace; font-size:12.5px; color:var(--smx-ink);
        text-decoration:none; overflow:hidden; white-space:nowrap; text-overflow:ellipsis;
    }
    .smx-link-ic{ flex:none; color:var(--smx-muted); }

    @@media (max-width:860px){
        .smxc-grid{ grid-template-columns:1fr; }
        .smxc-preview-col{ position:static; order:-1; }
    }
</style>

<script>
    (function () {
        const imgInput = document.getElementById('ImageUrl400x300');
        const iconInput = document.getElementById('IconUrl');
        const linkInput = document.getElementById('SocialMediaLink');

        const previewCard = document.getElementById('smxcPreviewCard');
        const previewImg = document.getElementById('smxcPreviewImg');
        const mediaPlaceholder = document.getElementById('smxcMediaPlaceholder');
        const previewIcon = document.getElementById('smxcPreviewIcon');
        const previewLink = document.getElementById('smxcPreviewLink');
        const previewLinkText = document.getElementById('smxcPreviewLinkText');

        function detectPlatform(url) {
            if (!url) return 'default';
            url = url.toLowerCase();
            if (url.includes('instagram')) return 'instagram';
            if (url.includes('facebook')) return 'facebook';
            if (url.includes('twitter') || url.includes('x.com')) return 'x';
            if (url.includes('youtube')) return 'youtube';
            if (url.includes('linkedin')) return 'linkedin';
            if (url.includes('tiktok')) return 'tiktok';
            return 'default';
        }

        function updatePreview() {
            const imgVal = imgInput.value.trim();
            const iconVal = iconInput.value.trim();
            const linkVal = linkInput.value.trim();

            if (imgVal) {
                previewImg.src = imgVal;
                previewImg.style.display = 'block';
                mediaPlaceholder.style.display = 'none';
            } else {
                previewImg.style.display = 'none';
                mediaPlaceholder.style.display = 'flex';
            }

            previewIcon.className = iconVal || 'fa-solid fa-image';
            previewLinkText.textContent = linkVal || 'Bağlantı burada görünecek';
            previewLink.href = linkVal || '#';

            previewCard.className = 'smx-card platform-' + detectPlatform(linkVal);
        }

        previewImg.addEventListener('error', function () {
            previewImg.style.display = 'none';
            mediaPlaceholder.style.display = 'flex';
        });

        [imgInput, iconInput, linkInput].forEach(el => el.addEventListener('input', updatePreview));

        document.querySelectorAll('.smxc-chip').forEach(function (chip) {
            chip.addEventListener('click', function () {
                document.querySelectorAll('.smxc-chip').forEach(c => c.classList.remove('is-active'));
                chip.classList.add('is-active');

                iconInput.value = chip.dataset.icon;
                if (!imgInput.value.trim()) imgInput.value = chip.dataset.img;
                if (!linkInput.value.trim()) linkInput.value = chip.dataset.link;

                updatePreview();
            });
        });

        // Prefill from existing model values on load
        updatePreview();
    })();

    function smxuConfirmDelete(id) {
        if (confirm('Bu sosyal medya hesabını silmek istediğinize emin misiniz?')) {
            document.getElementById('smxuDeleteId').value = id;
            document.getElementById('smxuDeleteForm').submit();
        }
    }
</script>
