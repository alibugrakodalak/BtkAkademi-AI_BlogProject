@model List<ResultMessageDto>

@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var total = Model.Count;
    var unreadCount = Model.Count(m => !m.IsRead);
    var readCount = total - unreadCount;
    var todayCount = Model.Count(m => m.SendDate.Date == DateTime.Today);

    var avatarGradients = new[]
    {
        "linear-gradient(135deg, #6366F1, #8B5CF6)",
        "linear-gradient(135deg, #EC4899, #F43F5E)",
        "linear-gradient(135deg, #10B981, #14B8A6)",
        "linear-gradient(135deg, #F59E0B, #F97316)",
        "linear-gradient(135deg, #06B6D4, #3B82F6)",
        "linear-gradient(135deg, #A855F7, #D946EF)"
    };
}


<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .msg-inbox {
        font-family: 'Inter', sans-serif;
        --clr-primary: #4F46E5;
        --clr-primary-light: #EEF2FF;
        --clr-success: #10B981;
        --clr-success-light: #ECFDF5;
        --clr-danger: #EF4444;
        --clr-danger-light: #FEF2F2;
        --clr-amber: #F59E0B;
        --clr-amber-light: #FFFBEB;
        --clr-text: #1E293B;
        --clr-muted: #64748B;
        --clr-border: #E2E8F0;
        color: var(--clr-text);
    }

    .msg-inbox .page-header h3 { font-weight: 700; letter-spacing: -0.02em; }
    .msg-inbox .page-header p { color: var(--clr-muted); font-size: 0.925rem; }

    /* Stat cards */
    .msg-inbox .stat-card {
        background: #fff; border: 1px solid var(--clr-border); border-radius: 14px;
        padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1rem;
        transition: box-shadow .2s ease, transform .2s ease; height: 100%;
    }
    .msg-inbox .stat-card:hover { box-shadow: 0 8px 20px rgba(15, 23, 42, .06); transform: translateY(-2px); }
    .msg-inbox .stat-icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
    }
    .msg-inbox .stat-value { font-size: 1.65rem; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .msg-inbox .stat-label { color: var(--clr-muted); font-size: 0.8rem; font-weight: 500; }

    /* Filter pills */
    .msg-inbox .filter-tabs .btn {
        border-radius: 50rem !important;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 0.4rem 1.1rem;
    }

    /* Table card */
    .msg-inbox .inbox-card { border: 1px solid var(--clr-border); border-radius: 14px; overflow: hidden; }
    .msg-inbox table { margin-bottom: 0; }
    .msg-inbox thead th {
        background: #F8FAFC; color: var(--clr-muted); font-size: 0.75rem;
        text-transform: uppercase; letter-spacing: .04em; font-weight: 600;
        border-bottom: 1px solid var(--clr-border); padding: 0.85rem 1rem;
    }
    .msg-inbox thead th.sortable { cursor: pointer; user-select: none; white-space: nowrap; transition: color .15s ease; }
    .msg-inbox thead th.sortable:hover { color: var(--clr-primary); }
    .msg-inbox thead th .sort-icon { font-size: 0.7rem; margin-left: 5px; opacity: 0.45; vertical-align: 1px; }
    .msg-inbox thead th .sort-icon.active { opacity: 1; color: var(--clr-primary); }
    .msg-inbox tbody td { padding: 0.85rem 1rem; vertical-align: middle; border-bottom: 1px solid #F1F5F9; }
    .msg-inbox tbody tr { transition: background .15s ease; }
    .msg-inbox tbody tr:hover { background: #F8FAFC; }
    .msg-inbox tbody tr.is-unread { box-shadow: inset 3px 0 0 var(--clr-primary); background: #FAFAFF; }
    .msg-inbox tbody tr.is-unread .sender-name { font-weight: 600; }

    .msg-inbox .avatar {
        width: 40px; height: 40px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 600; font-size: 0.85rem; color: #fff; flex-shrink: 0;
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
    }
    .msg-inbox .sender-name { font-size: 0.9rem; }
    .msg-inbox .sender-email { font-size: 0.78rem; color: var(--clr-muted); }

    .msg-inbox .subject-text {
        max-width: 260px; overflow: hidden; text-overflow: ellipsis;
        white-space: nowrap; display: inline-block; font-weight: 500;
    }

    .msg-inbox .badge-status {
        font-weight: 600; font-size: 0.75rem; padding: 0.35em 0.75em;
        border-radius: 20px; color: #fff; display: inline-flex; align-items: center; gap: .35rem;
        box-shadow: 0 2px 5px rgba(0,0,0,.1);
    }

    .msg-inbox .action-btn {
        width: 32px; height: 32px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--clr-border); color: var(--clr-muted); background: #fff;
        transition: all .15s ease; cursor: pointer;
    }
    .msg-inbox .action-btn:hover { border-color: var(--clr-primary); color: var(--clr-primary); background: var(--clr-primary-light); }
    .msg-inbox .action-btn.edit:hover { border-color: var(--clr-amber); color: var(--clr-amber); background: var(--clr-amber-light); }
    .msg-inbox .action-btn.danger:hover { border-color: var(--clr-danger); color: var(--clr-danger); background: var(--clr-danger-light); }

    .msg-inbox .empty-state { text-align: center; padding: 3.5rem 1rem; color: var(--clr-muted); }
    .msg-inbox .empty-state i { font-size: 2.5rem; color: #CBD5E1; margin-bottom: 0.75rem; display: block; }

    /* Detail modal */
    .msg-inbox .msg-detail-modal {
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 50px rgba(15, 23, 42, .15);
    }
</style>

<main class="page-content">
<div class="msg-inbox">

    <div class="page-header d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
        <div>
            <h3 class="mb-1">Gelen Mesajlar</h3>
            <p class="mb-0">Ziyaretçilerden gelen mesajları görüntüle ve yönet</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--clr-primary-light); color: var(--clr-primary);">
                    <i class="bi bi-envelope-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@total</div>
                    <div class="stat-label">Toplam Mesaj</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--clr-danger-light); color: var(--clr-danger);">
                    <i class="bi bi-envelope-exclamation-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@unreadCount</div>
                    <div class="stat-label">Okunmamış</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--clr-success-light); color: var(--clr-success);">
                    <i class="bi bi-envelope-open-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@readCount</div>
                    <div class="stat-label">Okundu</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-icon" style="background: var(--clr-amber-light); color: var(--clr-amber);">
                    <i class="bi bi-calendar-check-fill"></i>
                </div>
                <div>
                    <div class="stat-value">@todayCount</div>
                    <div class="stat-label">Bugün Gelen</div>
                </div>
            </div>
        </div>
    </div>

    <div class="inbox-card bg-white">
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom flex-wrap gap-2">
            <div class="filter-tabs d-flex gap-2">
                <button type="button" class="btn btn-primary active" data-filter="all">Tümü (@total)</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="unread">Okunmamış (@unreadCount)</button>
                <button type="button" class="btn btn-outline-secondary" data-filter="read">Okundu (@readCount)</button>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <div class="fw-semibold">Henüz gelen mesaj yok</div>
                <div class="small">Yeni mesajlar geldiğinde burada listelenecek.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th class="sortable" data-sort="name">Gönderen <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-sort="subject">Konu <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-sort="status">AI Durumu <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="sortable" data-sort="date">Tarih <i class="bi bi-arrow-down-up sort-icon"></i></th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var msg = Model[i];
                            var initials = $"{msg.Name?.FirstOrDefault()}{msg.Surname?.FirstOrDefault()}".ToUpper();
                            var avatarBg = avatarGradients[i % avatarGradients.Length];
                            var rowClass = msg.IsRead ? "is-read" : "is-unread";
                            var filterAttr = msg.IsRead ? "read" : "unread";
                            var fullName = $"{msg.Name} {msg.Surname}".Trim();

                            var statusKey = msg.AIStatus?.ToLower() ?? "";
                            string statusBg, statusIcon;
                            if (statusKey.Contains("toksik"))
                            {
                                // Toksik Mesaj
                                statusBg = "#DC2626"; statusIcon = "bi-exclamation-octagon-fill";
                            }
                            else if (statusKey.Contains("birliğ") || statusKey.Contains("birlik") || statusKey.Contains("collaboration"))
                            {
                                // İş Birliği Mesajı
                                statusBg = "#2563EB"; statusIcon = "bi-people-fill";
                            }
                            else if (statusKey.Contains("geri bildirim") || statusKey.Contains("feedback"))
                            {
                                // Geri Bildirim
                                statusBg = "#D97706"; statusIcon = "bi-chat-square-text-fill";
                            }
                            else if (statusKey.Contains("öncelik") || statusKey.Contains("oncelik") || statusKey.Contains("priority"))
                            {
                                // Öncelikli Mesaj
                                statusBg = "#7C3AED"; statusIcon = "bi-star-fill";
                            }
                            else if (statusKey.Contains("genel") || statusKey.Contains("general"))
                            {
                                // Genel Mesaj
                                statusBg = "#0D9488"; statusIcon = "bi-chat-dots-fill";
                            }
                            else
                            {
                                statusBg = "#64748B"; statusIcon = "bi-question-circle";
                            }
                            <tr class="@rowClass" data-status="@filterAttr"
                                data-sort-name="@fullName"
                                data-sort-subject="@msg.Subject"
                                data-sort-status="@(msg.AIStatus ?? "")"
                                data-sort-date="@msg.SendDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar" style="background: @avatarBg;">@initials</div>
                                        <div>
                                            <div class="sender-name">@msg.Name @msg.Surname</div>
                                            <div class="sender-email">@msg.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="subject-text" title="@msg.MessageDetail">@msg.Subject</span>
                                </td>
                                <td>
                                    <span class="badge-status" style="background: @statusBg;">
                                        <i class="bi @statusIcon"></i>@(msg.AIStatus ?? "Belirsiz")
                                    </span>
                                </td>
                                <td class="text-muted" style="font-size: 0.85rem;">
                                    @msg.SendDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    <button type="button" class="action-btn" title="Görüntüle"
                                            data-bs-toggle="modal" data-bs-target="#messageDetailModal"
                                            data-avatar="@avatarBg"
                                            data-initials="@initials"
                                            data-name="@msg.Name @msg.Surname"
                                            data-email="@msg.Email"
                                            data-subject="@msg.Subject"
                                            data-detail="@msg.MessageDetail"
                                            data-date="@msg.SendDate.ToString("dd.MM.yyyy HH:mm")"
                                            data-status="@(msg.AIStatus ?? "Belirsiz")"
                                            data-status-color="@statusBg"
                                            data-status-icon="@statusIcon">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <a asp-action="Edit" asp-route-id="@msg.MessageId" class="action-btn edit" title="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@msg.MessageId" class="action-btn danger" title="Sil"
                                       onclick="return confirm('Bu mesajı silmek istediğinize emin misiniz?');">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Mesaj Detay Modal -->
    <div class="modal fade" id="messageDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content msg-detail-modal">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body pt-0">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="avatar" id="modalAvatar" style="width:52px;height:52px;font-size:1.1rem;">--</div>
                        <div>
                            <div class="fw-semibold" id="modalName" style="font-size:1.05rem;"></div>
                            <div class="sender-email" id="modalEmail"></div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                        <span class="badge-status" id="modalStatus">
                            <i class="bi" id="modalStatusIcon"></i>
                            <span id="modalStatusText"></span>
                        </span>
                        <span class="text-muted small" id="modalDate"></span>
                    </div>
                    <h5 class="mb-2" id="modalSubject"></h5>
                    <p class="mb-0 text-body" id="modalDetail" style="white-space: pre-line; line-height:1.6;"></p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <a href="#" id="modalMailto" class="btn btn-outline-primary btn-sm rounded-pill">
                        <i class="bi bi-reply-fill me-1"></i>Yanıtla
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Filtre butonları
        var buttons = document.querySelectorAll('.msg-inbox .filter-tabs button');
        var rows = document.querySelectorAll('.msg-inbox tbody tr');

        buttons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                buttons.forEach(function (b) {
                    b.classList.remove('btn-primary', 'active');
                    b.classList.add('btn-outline-secondary');
                });
                btn.classList.add('btn-primary', 'active');
                btn.classList.remove('btn-outline-secondary');

                var filter = btn.getAttribute('data-filter');
                rows.forEach(function (row) {
                    row.style.display = (filter === 'all' || row.getAttribute('data-status') === filter) ? '' : 'none';
                });
            });
        });

        // Detay modal doldurma
        var messageModal = document.getElementById('messageDetailModal');
        messageModal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;

            document.getElementById('modalAvatar').style.background = btn.getAttribute('data-avatar');
            document.getElementById('modalAvatar').textContent = btn.getAttribute('data-initials');
            document.getElementById('modalName').textContent = btn.getAttribute('data-name');
            document.getElementById('modalEmail').textContent = btn.getAttribute('data-email');
            document.getElementById('modalSubject').textContent = btn.getAttribute('data-subject');
            document.getElementById('modalDetail').textContent = btn.getAttribute('data-detail');
            document.getElementById('modalDate').textContent = btn.getAttribute('data-date');

            document.getElementById('modalStatus').style.background = btn.getAttribute('data-status-color');
            document.getElementById('modalStatusIcon').className = 'bi ' + btn.getAttribute('data-status-icon');
            document.getElementById('modalStatusText').textContent = btn.getAttribute('data-status');

            var email = btn.getAttribute('data-email');
            var subject = btn.getAttribute('data-subject');
            document.getElementById('modalMailto').href = 'mailto:' + email + '?subject=' + encodeURIComponent('Re: ' + subject);
        });

        // Sütun başlığına tıklayarak sıralama (A-Z / Z-A)
        var sortableHeaders = document.querySelectorAll('.msg-inbox thead th.sortable');
        var tbodyEl = document.querySelector('.msg-inbox tbody');
        var currentSort = { key: null, dir: null };

        sortableHeaders.forEach(function (th) {
            th.addEventListener('click', function () {
                var key = th.getAttribute('data-sort');
                var dir = (currentSort.key === key && currentSort.dir === 'asc') ? 'desc' : 'asc';
                currentSort = { key: key, dir: dir };

                // Tüm ikonları sıfırla
                sortableHeaders.forEach(function (h) {
                    var icon = h.querySelector('.sort-icon');
                    icon.className = 'bi bi-arrow-down-up sort-icon';
                });

                // Aktif ikonu güncelle
                var activeIcon = th.querySelector('.sort-icon');
                activeIcon.className = 'bi ' + (dir === 'asc' ? 'bi-sort-alpha-down' : 'bi-sort-alpha-up') + ' sort-icon active';

                var rowsArr = Array.prototype.slice.call(tbodyEl.querySelectorAll('tr'));
                rowsArr.sort(function (a, b) {
                    var av = (a.getAttribute('data-sort-' + key) || '').toLowerCase();
                    var bv = (b.getAttribute('data-sort-' + key) || '').toLowerCase();

                    var cmp;
                    if (key === 'date') {
                        cmp = av < bv ? -1 : (av > bv ? 1 : 0);
                    } else {
                        cmp = av.localeCompare(bv, 'tr');
                    }
                    return dir === 'asc' ? cmp : -cmp;
                });

                rowsArr.forEach(function (row) {
                    tbodyEl.appendChild(row);
                });
            });
        });
    })();
</script>
</main>
